package br.com.jangoi.lista02;

import java.util.Scanner;

public class Exercicio13 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Digite o primeiro número: ");
        double n1 = scanner.nextDouble();

        System.out.print("Digite o segundo número: ");
        double n2 = scanner.nextDouble();

        System.out.println("Escolha uma opção:");
        System.out.println("1 - Soma");
        System.out.println("2 - Subtração");
        System.out.println("3 - Multiplicação");
        System.out.println("4 - Divisão");
        System.out.print("Opção: ");
        int opcao = scanner.nextInt();

        switch (opcao) {
            case 1 -> System.out.printf("Resultado da soma: %.2f%n", (n1 + n2));
            case 2 -> System.out.printf("Resultado da subtração: %.2f%n", (n1 - n2));
            case 3 -> System.out.printf("Resultado da multiplicação: %.2f%n", (n1 * n2));
            case 4 -> {
                if (n2 == 0) {
                    System.out.println("Erro: Divisão por zero não é permitida.");
                } else {
                    System.out.printf("Resultado da divisão: %.2f%n", (n1 / n2));
                }
            }
            default -> System.out.println("Opção inválida.");
        }

        scanner.close();
    }
}

